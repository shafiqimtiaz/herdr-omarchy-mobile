          "background": {
            "image": "backgrounds/omarchy-retro-82.webp",
            "fit": "cover"
          },
          "padding": 12
        },
        {
          "id": "code",
          "type": "column",
          "children": [
            {
              "id": "m-seg",
              "type": "block",
              "content": {
